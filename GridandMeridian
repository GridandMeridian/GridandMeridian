<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Grid & Meridian | Canada & USA Asset Portfolio</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        amber: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        },
                        slate: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#020617',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Leaflet GIS Map CSS & JS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 3px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #f59e0b;
        }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col custom-scrollbar">

    <!-- HEADER / NAVIGATION -->
    <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-40 px-4 py-3">
        <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
            
            <!-- Brand & Tagline -->
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-400 flex items-center justify-center text-slate-950 font-black text-xl shadow-lg shadow-amber-500/20">
                    G&M
                </div>
                <div>
                    <h1 class="text-lg font-black tracking-tight text-white flex items-center gap-2">
                        Grid & Meridian 
                        <span class="text-[10px] font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/30 px-2 py-0.5 rounded-full uppercase">CA & US Assets</span>
                    </h1>
                    <p class="text-xs text-slate-400">Direct Land & Real Estate Portfolio Platform</p>
                </div>
            </div>

            <!-- Global Controls & CTA -->
            <div class="flex items-center space-x-3 w-full md:w-auto justify-between md:justify-end">
                
                <!-- Currency Selector -->
                <div class="bg-slate-800 border border-slate-700 rounded-lg p-1 flex items-center text-xs font-bold text-slate-300">
                    <button id="curr-cad" onclick="setCurrency('CAD')" class="px-2.5 py-1 rounded-md bg-amber-500 text-slate-950 transition-all">CAD 🇨🇦</button>
                    <button id="curr-usd" onclick="setCurrency('USD')" class="px-2.5 py-1 rounded-md hover:text-white transition-all">USD 🇺🇸</button>
                </div>

                <!-- Navigation Tabs -->
                <div class="hidden lg:flex items-center bg-slate-800/80 border border-slate-700 rounded-lg p-1 text-xs font-medium">
                    <button onclick="switchTab('map-view')" id="tab-map" class="px-3 py-1 rounded-md bg-slate-700 text-white font-bold transition">Browse Map</button>
                    <button onclick="switchTab('pricing-view')" id="tab-pricing" class="px-3 py-1 rounded-md text-slate-400 hover:text-white transition">Pricing & Membership</button>
                    <button onclick="switchTab('dashboard-view')" id="tab-dashboard" class="px-3 py-1 rounded-md text-slate-400 hover:text-white transition">Owner Dashboard</button>
                </div>

                <!-- Primary CTA: List Asset Button -->
                <button onclick="openModal('googleFormModal')" class="bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-extrabold px-4 py-2 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition-all transform active:scale-95 flex items-center gap-1.5">
                    <i class="fa-solid fa-plus-circle text-sm"></i> 
                    <span>List Asset</span>
                </button>
            </div>
        </div>
    </header>

    <!-- MAIN BODY CONTAINER -->
    <main class="flex-grow flex flex-col relative pb-12 md:pb-0">

        <!-- VIEW 1: MAP & LISTINGS FEED -->
        <div id="map-view" class="flex-grow flex flex-col lg:flex-row h-[calc(100vh-4rem)]">
            
            <!-- LEFT GIS MAP CONTAINER -->
            <div class="w-full lg:w-3/5 h-1/2 lg:h-full relative border-r border-slate-800">
                <div id="map" class="w-full h-full"></div>
                
                <!-- FLOATING COUNTRY / JURISDICTION FILTER -->
                <div class="absolute top-4 left-4 z-20 bg-slate-900/95 backdrop-blur border border-slate-700/80 p-3 rounded-2xl shadow-2xl max-w-xs text-xs space-y-2">
                    <div class="flex items-center justify-between font-bold text-slate-200 border-b border-slate-800 pb-2">
                        <span><i class="fa-solid fa-earth-americas text-amber-500 mr-1.5"></i> Geographic Region</span>
                        <span class="text-[10px] text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded border border-amber-500/20 font-extrabold">1.5% Fee Rate</span>
                    </div>
                    <div class="flex space-x-1.5 pt-1">
                        <button id="btn-country-ALL" onclick="filterCountry('ALL')" class="flex-1 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-extrabold text-center transition">All</button>
                        <button id="btn-country-CA" onclick="filterCountry('CA')" class="flex-1 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-center border border-slate-700 transition">🇨🇦 CA</button>
                        <button id="btn-country-US" onclick="filterCountry('US')" class="flex-1 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-center border border-slate-700 transition">🇺🇸 US</button>
                    </div>
                </div>

                <!-- FLOATING PLATFORM CLOSING GUARANTEE -->
                <div class="hidden sm:flex absolute bottom-6 left-4 z-20 bg-slate-900/95 backdrop-blur border border-amber-500/40 p-3.5 rounded-2xl shadow-2xl items-center space-x-3.5 max-w-md">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center text-font-black text-base border border-amber-500/40 shrink-0 font-extrabold">
                        1.5%
                    </div>
                    <div>
                        <p class="text-xs font-black text-white">Flat Rate Platform Closing Fee</p>
                        <p class="text-[11px] text-slate-400">Keep maximum equity on your property transactions vs traditional 5-6% fees.</p>
                    </div>
                </div>
            </div>

            <!-- RIGHT SHOWCASE LISTINGS FEED -->
            <div class="w-full lg:w-2/5 h-1/2 lg:h-full bg-[#0f172a] overflow-y-auto flex flex-col custom-scrollbar">
                
                <!-- Category Filter Top Header -->
                <div class="p-4 border-b border-slate-800 sticky top-0 bg-[#0f172a]/95 backdrop-blur z-20 space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="font-black text-base text-white flex items-center">
                            <i class="fa-solid fa-border-all text-amber-500 mr-2"></i> Portfolio Showcase
                        </h2>
                        <span class="text-xs text-slate-400 font-medium" id="listings-count">Showing 6 Portfolio Assets</span>
                    </div>
                    
                    <!-- Listing Category Badges -->
                    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs no-scrollbar">
                        <button onclick="filterType('ALL')" id="type-ALL" class="px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-bold shrink-0 transition">All Types</button>
                        <button onclick="filterType('Raw Land')" id="type-Raw Land" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition">Raw Land</button>
                        <button onclick="filterType('Farms & Ranches')" id="type-Farms & Ranches" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition">Farms & Ranches</button>
                        <button onclick="filterType('Residential')" id="type-Residential" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition">Residential</button>
                        <button onclick="filterType('Businesses')" id="type-Businesses" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition">Businesses</button>
                        <button onclick="filterType('Rentals')" id="type-Rentals" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition">Rentals</button>
                    </div>
                </div>

                <!-- Listings Feed Container -->
                <div id="listings-feed" class="p-4 grid grid-cols-1 gap-4 flex-grow">
                    <!-- Dynamic rendering via JS -->
                </div>
            </div>
        </div>

        <!-- VIEW 2: PRICING & MEMBERSHIPS -->
        <div id="pricing-view" class="hidden max-w-7xl mx-auto px-4 py-10 w-full space-y-12">
            <div class="text-center max-w-3xl mx-auto space-y-4">
                <span class="text-xs font-black tracking-widest text-amber-500 uppercase bg-amber-500/10 px-3.5 py-1.5 rounded-full border border-amber-500/20">Asset Owner & Developer Subscriptions</span>
                <h2 class="text-3xl md:text-5xl font-black text-white tracking-tight">Simple, Transparent Memberships</h2>
                <p class="text-slate-400 text-sm md:text-base">Promote and list real estate assets, commercial businesses, and ranch properties across Canada and the United States with our flat 1.5% platform closing fee guarantee.</p>
            </div>

            <!-- PRICING CARDS GRID -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-stretch">
                
                <!-- Silver Tier -->
                <div class="bg-slate-900/80 rounded-3xl border border-slate-800 p-8 flex flex-col justify-between hover:border-slate-700 transition relative">
                    <div class="space-y-6">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Entry Level</span>
                            <h3 class="text-2xl font-black text-white mt-1">Silver Plan</h3>
                            <p class="text-xs text-slate-400 mt-1">Perfect for individual property & land owners.</p>
                        </div>
                        <div class="flex items-baseline">
                            <span class="text-5xl font-black text-white price-silver">$49</span>
                            <span class="text-slate-400 text-sm font-semibold ml-1.5"><span class="curr-label">CAD</span> / month</span>
                        </div>
                        <div class="border-t border-slate-800 pt-6">
                            <ul class="space-y-3.5 text-xs text-slate-300 font-medium">
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>1 Active Geographic Map Pin</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Standard GIS Map & Feed Visibility</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Direct Owner Lead Submission Form</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Standard 1.5% Flat Rate Fee Savings</li>
                            </ul>
                        </div>
                    </div>
                    <button onclick="subscribePlan('Silver')" class="mt-8 w-full py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 font-extrabold text-white text-xs tracking-wider uppercase transition border border-slate-700">Choose Silver</button>
                </div>

                <!-- Gold Tier (FEATURED) -->
                <div class="bg-slate-900 rounded-3xl border-2 border-amber-500 p-8 flex flex-col justify-between relative shadow-2xl shadow-amber-500/10 transform md:-translate-y-2">
                    <div class="absolute -top-4 left-1/2 -translate-x-1/2 bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 text-[10px] font-black uppercase tracking-widest px-4 py-1.5 rounded-full shadow-lg border border-amber-300">MOST POPULAR CHOICE</div>
                    <div class="space-y-6">
                        <div>
                            <span class="text-xs font-bold text-amber-400 uppercase tracking-widest">Pro Portfolio</span>
                            <h3 class="text-2xl font-black text-white mt-1">Gold Plan</h3>
                            <p class="text-xs text-slate-400 mt-1">For active asset managers & multi-property sellers.</p>
                        </div>
                        <div class="flex items-baseline">
                            <span class="text-5xl font-black text-amber-400 price-gold">$99</span>
                            <span class="text-slate-400 text-sm font-semibold ml-1.5"><span class="curr-label">CAD</span> / month</span>
                        </div>
                        <div class="border-t border-slate-800 pt-6">
                            <ul class="space-y-3.5 text-xs text-slate-300 font-medium">
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Up to 5 Active Map Listings</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Featured Placement in Feed & Search</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Instant Email & SMS Lead Notifications</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Customized Asset Pitch Page</li>
                            </ul>
                        </div>
                    </div>
                    <button onclick="subscribePlan('Gold')" class="mt-8 w-full py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-black text-xs tracking-wider uppercase shadow-lg shadow-amber-500/20 transition">Select Gold Tier</button>
                </div>

                <!-- Platinum Tier -->
                <div class="bg-slate-900/80 rounded-3xl border border-slate-800 p-8 flex flex-col justify-between hover:border-slate-700 transition relative">
                    <div class="space-y-6">
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Enterprise</span>
                            <h3 class="text-2xl font-black text-white mt-1">Platinum Plan</h3>
                            <p class="text-xs text-slate-400 mt-1">Designed for brokerage firms & commercial developers.</p>
                        </div>
                        <div class="flex items-baseline">
                            <span class="text-5xl font-black text-white price-platinum">$199</span>
                            <span class="text-slate-400 text-sm font-semibold ml-1.5"><span class="curr-label">CAD</span> / month</span>
                        </div>
                        <div class="border-t border-slate-800 pt-6">
                            <ul class="space-y-3.5 text-xs text-slate-300 font-medium">
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Unlimited Active Map Listings</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Top-Tier Gold Map Pin Badging</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Banner Promotion Across All Map Views</li>
                                <li class="flex items-center"><i class="fa-solid fa-circle-check text-amber-500 text-sm mr-2.5"></i>Dedicated Account Manager & Support</li>
                            </ul>
                        </div>
                    </div>
                    <button onclick="subscribePlan('Platinum')" class="mt-8 w-full py-3.5 rounded-xl bg-slate-800 hover:bg-slate-700 font-extrabold text-white text-xs tracking-wider uppercase transition border border-slate-700">Choose Platinum</button>
                </div>
            </div>

            <!-- 1.5% FLAT RATE CALCULATOR SECTION -->
            <div class="bg-slate-900/90 rounded-3xl border border-slate-800 p-8 max-w-4xl mx-auto space-y-6 shadow-2xl">
                <div class="text-center space-y-1">
                    <h3 class="text-2xl font-black text-white">1.5% Platform Closing Fee Savings Calculator</h3>
                    <p class="text-xs text-slate-400">Calculate how much cash equity you retain using Grid & Meridian compared to traditional 5% broker fees.</p>
                </div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-center pt-2">
                    <div class="md:col-span-2 space-y-3">
                        <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Asset Valuation (<span class="curr-label">CAD</span>)</label>
                        <input type="range" id="fee-slider" min="100000" max="10000000" step="50000" value="1500000" oninput="calculateFee(this.value)" class="w-full accent-amber-500 bg-slate-800 h-2 rounded-lg cursor-pointer">
                        <div class="flex justify-between text-xs text-slate-500 font-bold">
                            <span>$100,000</span>
                            <span id="slider-val-display" class="text-amber-400 text-sm font-black">$1,500,000</span>
                            <span>$10,000,000</span>
                        </div>
                    </div>
                    
                    <div class="bg-slate-950 border border-slate-800 rounded-2xl p-4 space-y-2 text-center">
                        <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Your Equity Savings</span>
                        <div id="savings-amount" class="text-2xl font-black text-emerald-400">$52,500</div>
                        <p class="text-[10px] text-slate-500">Saved in closing commissions!</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- VIEW 3: OWNER DASHBOARD -->
        <div id="dashboard-view" class="hidden max-w-7xl mx-auto px-4 py-8 w-full space-y-8">
            <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border-b border-slate-800 pb-6">
                <div>
                    <h2 class="text-2xl md:text-3xl font-black text-white tracking-tight">Asset Manager Dashboard</h2>
                    <p class="text-xs text-slate-400 mt-1">Manage map visibility, monitor lead inquiries, and submit new property records.</p>
                </div>
                <button onclick="openModal('googleFormModal')" class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-black px-4 py-2.5 rounded-xl text-xs shadow-lg shadow-amber-500/20 transition flex items-center">
                    <i class="fa-solid fa-plus-circle mr-2"></i> Submit New Listing Details
                </button>
            </div>

            <!-- Metrics Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-5">
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 space-y-1">
                    <span class="text-xs font-semibold text-slate-400">Total Portfolio Impressions</span>
                    <p class="text-3xl font-black text-white">52,180</p>
                    <span class="text-[11px] text-emerald-400 font-bold"><i class="fa-solid fa-arrow-trend-up mr-1"></i>+18.4% this month</span>
                </div>
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 space-y-1">
                    <span class="text-xs font-semibold text-slate-400">Direct Buyer Inquiries</span>
                    <p class="text-3xl font-black text-white">4,290</p>
                    <span class="text-[11px] text-emerald-400 font-bold"><i class="fa-solid fa-arrow-trend-up mr-1"></i>+24.1% this month</span>
                </div>
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 space-y-1">
                    <span class="text-xs font-semibold text-slate-400">Across Canada & USA</span>
                    <p class="text-3xl font-black text-white">118</p>
                    <span class="text-[11px] text-slate-400 font-semibold">Active Member Assets</span>
                </div>
                <div class="bg-slate-900/90 p-5 rounded-2xl border border-slate-800 space-y-1">
                    <span class="text-xs font-semibold text-slate-400">Current Plan Status</span>
                    <p class="text-2xl font-black text-amber-500">GOLD TIER</p>
                    <span class="text-[11px] text-slate-400 font-semibold">Active Member</span>
                </div>
            </div>

            <!-- Active Assets Management Table -->
            <div class="bg-slate-900/90 rounded-2xl border border-slate-800 overflow-hidden shadow-xl">
                <div class="p-4 border-b border-slate-800 font-black text-white text-sm flex items-center justify-between">
                    <span><i class="fa-solid fa-folder-open text-amber-500 mr-2"></i> Manage Portfolio Listings</span>
                    <span class="text-xs text-slate-400 font-normal">Showing 5 Sample Listings</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs text-slate-300">
                        <thead class="bg-slate-950 text-slate-400 uppercase tracking-widest border-b border-slate-800 font-bold">
                            <tr>
                                <th class="p-4">Property Name</th>
                                <th class="p-4">Category</th>
                                <th class="p-4">Location</th>
                                <th class="p-4">Closed Price</th>
                                <th class="p-4">Status</th>
                                <th class="p-4 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-800">
                            <tr class="hover:bg-slate-800/50">
                                <td class="p-4 font-bold text-white">Thunder Bay Timberland</td>
                                <td class="p-4"><span class="px-2 py-1 rounded bg-slate-800 text-amber-400 border border-slate-700">Raw Land</span></td>
                                <td class="p-4">Ontario, Canada 🇨🇦</td>
                                <td class="p-4 font-black text-white prop-price-0">$1,850,000</td>
                                <td class="p-4"><span class="px-2.5 py-1 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-extrabold uppercase text-[10px]">SOLD / CLOSED</span></td>
                                <td class="p-4 text-right space-x-2">
                                    <button class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-200">View</button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/50">
                                <td class="p-4 font-bold text-white">Heartland Cattle Ranch</td>
                                <td class="p-4"><span class="px-2 py-1 rounded bg-slate-800 text-amber-400 border border-slate-700">Farms & Ranches</span></td>
                                <td class="p-4">Alberta, Canada 🇨🇦</td>
                                <td class="p-4 font-black text-white prop-price-1">$4,200,000</td>
                                <td class="p-4"><span class="px-2.5 py-1 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-extrabold uppercase text-[10px]">SOLD / CLOSED</span></td>
                                <td class="p-4 text-right space-x-2">
                                    <button class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 rounded text-slate-200">View</button>
                                </td>
                            </tr>
                            <tr class="hover:bg-slate-800/50">
                                <td class="p-4 font-bold text-white">Austin Tech Hub Commercial Center</td>
                                <td class="p-4"><span class="px-2 py-1 rounded bg-slate-800 text-amber-400 border border-slate-700">Businesses</span></td>
                                <td class="p-4">Texas, USA 🇺🇸</td>
                                <td class="p-4 font-black text-white prop-price-2">$6,500,000</td>
                                <td class="p-4"><span class="px-2.5 py-1 rounded-full bg-rose-500/20 text-rose-400 border border-rose-500/30 font-extrabold uppercase text-[10px]">SOLD / CLOSED</span></td>
                                <td class="p-4 text-right space-x-2">
