                    width="100%" 
                    height="1200" 
                    frameborder="0" 
                    marginheight="0" 
                    marginwidth="0"
                    class="w-full border-0 rounded-2xl min-h-[1200px]"
                    title="Asset Submission Google Form">
                    Loading Form...
                </iframe>
            </div>

            <!-- Modal Footer Bar -->
            <div class="bg-slate-950 px-6 py-3 border-t border-slate-800 flex justify-between items-center shrink-0">
                <span class="text-xs text-slate-500"><i class="fa-solid fa-shield-halved text-amber-500 mr-1"></i> Secure Direct Submission</span>
                <button onclick="closeModal('googleFormModal')" class="px-5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 font-bold text-xs text-slate-300 transition">Close Window</button>
            </div>
        </div>
    </div>

    <!-- JAVASCRIPT APP LOGIC -->
    <script>
        // State variables
        let currentCurrency = 'CAD';
        const usdRate = 0.74; // CAD to USD conversion rate

        // Sample Portfolio Listings Data (Tagged as Sold/Recently Closed)
        const assetsData = [
            {
                id: 1,
                title: "Thunder Bay Timberland & Mineral Lot",
                type: "Raw Land",
                country: "CA",
                location: "Thunder Bay, Ontario, Canada",
                priceCAD: 1850000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80",
                lat: 48.3809,
                lng: -89.2477,
                size: "420 Acres"
            },
            {
                id: 2,
                title: "Heartland Cattle & Grain Ranch",
                type: "Farms & Ranches",
                country: "CA",
                location: "Foothills County, Alberta, Canada",
                priceCAD: 4200000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=800&q=80",
                lat: 50.7000,
                lng: -113.9000,
                size: "1,200 Acres"
            },
            {
                id: 3,
                title: "Austin Tech Hub Commercial Plaza",
                type: "Businesses",
                country: "US",
                location: "Austin, Texas, USA",
                priceCAD: 6500000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80",
                lat: 30.2672,
                lng: -97.7431,
                size: "24,000 SqFt"
            },
            {
                id: 4,
                title: "Okanagan Valley Vineyard & Estate",
                type: "Residential",
                country: "CA",
                location: "Kelowna, British Columbia, Canada",
                priceCAD: 3900000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?auto=format&fit=crop&w=800&q=80",
                lat: 49.8880,
                lng: -119.4960,
                size: "35 Acres"
            },
            {
                id: 5,
                title: "Big Sky Cattle Ranch & Water Rights",
                type: "Farms & Ranches",
                country: "US",
                location: "Bozeman, Montana, USA",
                priceCAD: 5800000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1500382017468-9049fed747ef?auto=format&fit=crop&w=800&q=80",
                lat: 45.6770,
                lng: -111.0429,
                size: "2,400 Acres"
            },
            {
                id: 6,
                title: "Banff Gateway Short-Term Rental Cabins",
                type: "Rentals",
                country: "CA",
                location: "Canmore, Alberta, Canada",
                priceCAD: 2150000,
                status: "SOLD / RECENTLY CLOSED",
                img: "https://images.unsplash.com/photo-1449157291145-7efd050a4d0e?auto=format&fit=crop&w=800&q=80",
                lat: 51.0890,
                lng: -115.3590,
                size: "4 Units"
            }
        ];

        let activeCountry = 'ALL';
        let activeType = 'ALL';
        let map, markersGroup;

        // Initialize GIS Leaflet Map
        function initMap() {
            map = L.map('map').setView([49.2827, -101.5547], 4);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO',
                maxZoom: 18
            }).addTo(map);

            markersGroup = L.layerGroup().addTo(map);
            renderMarkers();
        }

        // Render Map Markers
        function renderMarkers() {
            markersGroup.clearLayers();
            const filtered = getFilteredData();

            filtered.forEach(asset => {
                const priceText = formatCurrency(asset.priceCAD);
                const marker = L.marker([asset.lat, asset.lng]).addTo(markersGroup);
                marker.bindPopup(`
                    <div style="color: #0f172a; font-family: sans-serif; padding: 4px;">
                        <span style="font-size: 10px; font-weight: 800; background: #f59e0b; color: #020617; padding: 2px 6px; border-radius: 4px; uppercase">${asset.type}</span>
                        <h4 style="font-weight: 800; margin-top: 6px; margin-bottom: 2px; font-size: 14px;">${asset.title}</h4>
                        <p style="font-size: 11px; color: #475569; margin: 0;">${asset.location}</p>
                        <p style="font-size: 14px; font-weight: 900; color: #d97706; margin-top: 6px;">${priceText}</p>
                    </div>
                `);
            });
        }

        // Filter helper
        function getFilteredData() {
            return assetsData.filter(item => {
                const matchCountry = activeCountry === 'ALL' || item.country === activeCountry;
                const matchType = activeType === 'ALL' || item.type === activeType;
                return matchCountry && matchType;
            });
        }

        // Render Showcase Feed Cards
        function renderFeed() {
            const feedContainer = document.getElementById('listings-feed');
            const filtered = getFilteredData();
            document.getElementById('listings-count').innerText = `Showing ${filtered.length} Portfolio Assets`;

            feedContainer.innerHTML = filtered.map(asset => {
                const formattedPrice = formatCurrency(asset.priceCAD);
                return `
                    <div class="bg-slate-900 rounded-2xl border border-slate-800 overflow-hidden shadow-lg hover:border-amber-500/50 transition duration-300 group">
                        <div class="relative h-48 overflow-hidden">
                            <img src="${asset.img}" alt="${asset.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500">
                            <div class="absolute top-3 left-3 bg-rose-600 text-white font-extrabold text-[10px] px-3 py-1 rounded-full uppercase tracking-wider shadow-lg flex items-center gap-1">
                                <i class="fa-solid fa-lock text-[9px]"></i> ${asset.status}
                            </div>
                            <div class="absolute bottom-3 left-3 bg-slate-950/80 backdrop-blur text-amber-400 font-extrabold text-xs px-2.5 py-1 rounded-md border border-amber-500/30">
                                ${asset.type}
                            </div>
                        </div>
                        <div class="p-4 space-y-2">
                            <div class="flex justify-between items-start">
                                <h3 class="font-bold text-sm text-white group-hover:text-amber-400 transition">${asset.title}</h3>
                                <span class="font-black text-amber-400 text-sm">${formattedPrice}</span>
                            </div>
                            <p class="text-xs text-slate-400"><i class="fa-solid fa-location-dot text-amber-500 mr-1"></i> ${asset.location}</p>
                            <div class="flex items-center justify-between border-t border-slate-800 pt-3 mt-2 text-xs text-slate-400 font-medium">
                                <span><i class="fa-solid fa-ruler-combined mr-1 text-slate-500"></i> ${asset.size}</span>
                                <button onclick="openModal('googleFormModal')" class="text-amber-400 hover:text-amber-300 font-bold transition flex items-center gap-1">
                                    Inquire Asset <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        // Currency Switcher
        function setCurrency(curr) {
            currentCurrency = curr;
            document.getElementById('curr-cad').className = curr === 'CAD' ? 'px-2.5 py-1 rounded-md bg-amber-500 text-slate-950 transition-all font-bold' : 'px-2.5 py-1 rounded-md hover:text-white transition-all font-bold';
            document.getElementById('curr-usd').className = curr === 'USD' ? 'px-2.5 py-1 rounded-md bg-amber-500 text-slate-950 transition-all font-bold' : 'px-2.5 py-1 rounded-md hover:text-white transition-all font-bold';
            
            document.querySelectorAll('.curr-label').forEach(el => el.innerText = curr);
            
            // Update Plan Prices
            if (curr === 'USD') {
                document.querySelector('.price-silver').innerText = '$39';
                document.querySelector('.price-gold').innerText = '$79';
                document.querySelector('.price-platinum').innerText = '$149';
            } else {
                document.querySelector('.price-silver').innerText = '$49';
                document.querySelector('.price-gold').innerText = '$99';
                document.querySelector('.price-platinum').innerText = '$199';
            }

            renderMarkers();
            renderFeed();
            calculateFee(document.getElementById('fee-slider').value);
        }

        function formatCurrency(valCAD) {
            const val = currentCurrency === 'USD' ? valCAD * usdRate : valCAD;
            return new Intl.NumberFormat('en-US', { style: 'currency', currency: currentCurrency, maximumFractionDigits: 0 }).format(val);
        }

        // Country Filter
        function filterCountry(country) {
            activeCountry = country;
            ['ALL', 'CA', 'US'].forEach(c => {
                const btn = document.getElementById(`btn-country-${c}`);
                if (c === country) {
                    btn.className = 'flex-1 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-extrabold text-center transition';
                } else {
                    btn.className = 'flex-1 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-center border border-slate-700 transition';
                }
            });
            renderMarkers();
            renderFeed();
        }

        // Type Filter
        function filterType(type) {
            activeType = type;
            ['ALL', 'Raw Land', 'Farms & Ranches', 'Residential', 'Businesses', 'Rentals'].forEach(t => {
                const btn = document.getElementById(`type-${t}`);
                if (btn) {
                    if (t === type) {
                        btn.className = 'px-3 py-1.5 rounded-lg bg-amber-500 text-slate-950 font-bold shrink-0 transition';
                    } else {
                        btn.className = 'px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-300 font-medium shrink-0 border border-slate-700 transition';
                    }
                }
            });
            renderMarkers();
            renderFeed();
        }

        // Tab Navigation
        function switchTab(tabId) {
            ['map-view', 'pricing-view', 'dashboard-view'].forEach(id => {
                document.getElementById(id).classList.add('hidden');
            });
            document.getElementById(tabId).classList.remove('hidden');

            ['tab-map', 'tab-pricing', 'tab-dashboard'].forEach(t => {
                document.getElementById(t).className = 'px-3 py-1 rounded-md text-slate-400 hover:text-white transition';
            });
            
            if (tabId === 'map-view') {
                document.getElementById('tab-map').className = 'px-3 py-1 rounded-md bg-slate-700 text-white font-bold transition';
                if (map) setTimeout(() => map.invalidateSize(), 200);
            } else if (tabId === 'pricing-view') {
                document.getElementById('tab-pricing').className = 'px-3 py-1 rounded-md bg-slate-700 text-white font-bold transition';
            } else if (tabId === 'dashboard-view') {
                document.getElementById('tab-dashboard').className = 'px-3 py-1 rounded-md bg-slate-700 text-white font-bold transition';
            }
        }

        // Fee Savings Calculator Logic
        function calculateFee(value) {
            const val = parseFloat(value);
            document.getElementById('slider-val-display').innerText = formatCurrency(val);
            
            // Standard 5% broker fee vs Grid & Meridian 1.5% flat fee = 3.5% equity savings
            const savings = val * 0.035;
            document.getElementById('savings-amount').innerText = formatCurrency(savings);
        }

        // Modal Controllers
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }

        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        function subscribePlan(planName) {
            openModal('googleFormModal');
        }

        // Initialize on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            initMap();
            renderFeed();
            calculateFee(1500000);
        });
    </script>
</body>
</html>
