                        <i class="fa-solid fa-file-pen"></i>
                    </div>
                    <div>
                        <h3 class="font-black text-white text-base">Grid & Meridian Asset Intake Form</h3>
                        <p class="text-xs text-slate-400">Complete all questions to feature your property on our CA & US map network.</p>
                    </div>
                </div>
                <button onclick="closeModal('googleFormModal')" class="w-9 h-9 rounded-full bg-slate-800 hover:bg-slate-700 text-slate-300 flex items-center justify-center transition">
